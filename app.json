{
  "expo": {
    "name": "DevUTEC",
    "slug": "devutec-mobile",
    "owner": "devutec",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.edu.utec.devutec"
    },
    "android": {
      "package": "pe.edu.utec.devutec",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "DevUTEC usa Face ID para confirmar acciones importantes, como liberar un pago."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DevUTEC usa tu ubicación para sugerir el distrito del proyecto que publicas."
        }
      ]
    ],
    "scheme": "devutec"
  }
}
